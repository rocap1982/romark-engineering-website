---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

const galleryImages = [
  { src: '/images/warehouse-welder.jpg', alt: 'TIG welding on the fabrication bench at our Essex workshop' },
  { src: '/images/warehouse-press-brake.jpg', alt: 'Amada HFE 220-4 CNC press brake for precision folding' },
  { src: '/images/warehouse-workshop.jpg', alt: 'Inside the Romark Engineering workshop and material stores' },
  { src: '/images/gallery-kitchen-pod.jpg', alt: 'Bespoke stainless steel kitchen pod fabrication' },
  { src: '/images/gallery-cooker-unit.jpg', alt: 'Fabricated rear cooker unit assembly' },
  { src: '/images/gallery-aluminium-panels.jpg', alt: 'Aluminium panel fabrication and finishing' },
  { src: '/images/gallery-surface-finish.jpg', alt: 'Quality surface finish on machined component' },
  { src: '/images/services/cnc-machining.png', alt: 'CNC machining precision component' },
  { src: '/images/services/cnc-machining-2.png', alt: 'CNC machining centre in operation' },
  { src: '/images/services/fabrication-and-welding.png', alt: 'Fabrication and welding work' },
  { src: '/images/services/milling.png', alt: 'Precision milling on Bridgeport mill' },
  { src: '/images/services/milling-2.png', alt: 'Milling operation close-up' },
  { src: '/images/services/turning.png', alt: 'CNC turning on Harrison lathe' },
  { src: '/images/services/turning-2.png', alt: 'Turning operation producing cylindrical component' },
];
---

<Layout
  title="Gallery | Romark Engineering"
  description="View our gallery of precision engineering and sheet metal fabrication work. CNC machining, laser cutting, welding, and more from our Essex facility."
>
  <Hero
    title="Gallery"
    subtitle="A selection of our precision engineering and fabrication work, showcasing the quality and range of capabilities at our Essex facility."
    ctaText="Get a Quote"
    ctaHref="/contact-us/"
    secondaryCtaText="Our Services"
    secondaryCtaHref="/#services"
    backgroundImage="/images/warehouse-welder.jpg"
  />

  <!-- Gallery Grid -->
  <section class="py-(--spacing-section) bg-romark-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-14">
        <div class="w-16 h-1 bg-romark-orange mx-auto mb-4"></div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-romark-blue-dark mb-4">
          Our Work
        </h2>
        <p class="text-romark-gray-500 max-w-2xl mx-auto text-lg">
          From precision CNC components to bespoke fabrication and welding — see what we can do.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryImages.map((image) => (
          <div class="group relative overflow-hidden rounded-lg bg-romark-light border border-romark-gray-100">
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={image.src}
                alt={image.alt}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-romark-blue-dark/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <div class="absolute bottom-0 left-0 right-0 p-4">
                <p class="text-white text-sm font-semibold">{image.alt}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-(--spacing-section) bg-romark-light">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <div class="w-16 h-1 bg-romark-orange mx-auto mb-4"></div>
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-romark-blue-dark mb-4">
        Have a Project in Mind?
      </h2>
      <p class="text-romark-gray-500 text-lg mb-8 max-w-2xl mx-auto">
        Whether you need precision components, bespoke fabrication, or full assemblies, we are ready to help bring your project to life.
      </p>
      <a
        href="/contact-us/"
        class="inline-flex items-center justify-center px-8 py-3.5 bg-romark-orange text-white font-semibold rounded hover:bg-romark-orange-dark transition-colors text-lg"
      >
        Get a Quote
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>
  </section>
</Layout>
