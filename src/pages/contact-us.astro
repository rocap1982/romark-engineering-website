---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

const services = [
  'Laser Profiling',
  'Folding & Pressing',
  'Fabrication & Welding',
  'CNC Machining',
  'Milling',
  'Turning',
  'Sheet Metal Welding',
  'Blank Development',
  'CAD Design',
];
---

<Layout
  title="Contact Us | Romark Engineering"
  description="Contact Romark Engineering for precision engineering and sheet metal fabrication enquiries. Call 01375 673 447 or send us a message. Based in Stanford-Le-Hope, Essex."
>
  <Hero
    title="Contact Us"
    subtitle="Get in touch with our team for a free, no-obligation quote. We are here to discuss your precision engineering and fabrication requirements."
  />

  <!-- Contact Section -->
  <section class="py-(--spacing-section) bg-romark-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">

        <!-- Contact Form -->
        <div class="lg:col-span-3">
          <div class="w-16 h-1 bg-romark-orange mb-4"></div>
          <h2 class="text-2xl md:text-3xl font-heading font-bold text-romark-blue-dark mb-6">
            Send Us a Message
          </h2>

          <form id="contact-form" class="space-y-5" novalidate>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-sm font-semibold text-romark-blue-dark mb-1.5">
                  Name <span class="text-romark-orange">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 border border-romark-gray-100 rounded bg-romark-light text-romark-blue-dark placeholder-romark-gray-300 focus:outline-none focus:border-romark-orange focus:ring-1 focus:ring-romark-orange transition-colors"
                  placeholder="Your full name"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-semibold text-romark-blue-dark mb-1.5">
                  Email <span class="text-romark-orange">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 border border-romark-gray-100 rounded bg-romark-light text-romark-blue-dark placeholder-romark-gray-300 focus:outline-none focus:border-romark-orange focus:ring-1 focus:ring-romark-orange transition-colors"
                  placeholder="you@example.com"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="phone" class="block text-sm font-semibold text-romark-blue-dark mb-1.5">
                  Phone
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="w-full px-4 py-3 border border-romark-gray-100 rounded bg-romark-light text-romark-blue-dark placeholder-romark-gray-300 focus:outline-none focus:border-romark-orange focus:ring-1 focus:ring-romark-orange transition-colors"
                  placeholder="01234 567 890"
                />
              </div>
              <div>
                <label for="company" class="block text-sm font-semibold text-romark-blue-dark mb-1.5">
                  Company
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  class="w-full px-4 py-3 border border-romark-gray-100 rounded bg-romark-light text-romark-blue-dark placeholder-romark-gray-300 focus:outline-none focus:border-romark-orange focus:ring-1 focus:ring-romark-orange transition-colors"
                  placeholder="Your company name"
                />
              </div>
            </div>

            <div>
              <label for="service" class="block text-sm font-semibold text-romark-blue-dark mb-1.5">
                Service Required
              </label>
              <select
                id="service"
                name="service"
                class="w-full px-4 py-3 border border-romark-gray-100 rounded bg-romark-light text-romark-blue-dark focus:outline-none focus:border-romark-orange focus:ring-1 focus:ring-romark-orange transition-colors"
              >
                <option value="">Select a service (optional)</option>
                {services.map((service) => (
                  <option value={service}>{service}</option>
                ))}
                <option value="Other">Other / General Enquiry</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-romark-blue-dark mb-1.5">
                Message <span class="text-romark-orange">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full px-4 py-3 border border-romark-gray-100 rounded bg-romark-light text-romark-blue-dark placeholder-romark-gray-300 focus:outline-none focus:border-romark-orange focus:ring-1 focus:ring-romark-orange transition-colors resize-vertical"
                placeholder="Tell us about your project or requirements..."
              ></textarea>
            </div>

            <!-- Status Messages -->
            <div id="form-success" class="hidden p-4 bg-green-50 border border-green-200 rounded text-green-800 text-sm">
              Thank you for your message. We will be in touch shortly.
            </div>
            <div id="form-error" class="hidden p-4 bg-red-50 border border-red-200 rounded text-red-800 text-sm">
              Something went wrong. Please try again or call us directly.
            </div>

            <button
              type="submit"
              class="inline-flex items-center justify-center px-8 py-3.5 bg-romark-orange text-white font-semibold rounded hover:bg-romark-orange-dark transition-colors text-lg w-full sm:w-auto"
            >
              Send Message
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </button>
          </form>
        </div>

        <!-- Contact Details -->
        <div class="lg:col-span-2">
          <div class="bg-romark-blue-dark text-white rounded-lg p-8 sticky top-8">
            <h2 class="text-2xl font-heading font-bold mb-6">Get In Touch</h2>

            <div class="space-y-6">
              <!-- Address -->
              <div class="flex gap-4">
                <div class="w-10 h-10 bg-romark-orange/20 rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-romark-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold mb-1">Address</h3>
                  <p class="text-romark-gray-300 text-sm leading-relaxed">
                    Romark Engineering<br />
                    Stanford-Le-Hope<br />
                    Essex
                  </p>
                </div>
              </div>

              <!-- Phone -->
              <div class="flex gap-4">
                <div class="w-10 h-10 bg-romark-orange/20 rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-romark-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold mb-1">Phone</h3>
                  <a href="tel:01375673447" class="block text-romark-gray-300 text-sm hover:text-romark-orange transition-colors">01375 673 447</a>
                  <a href="tel:01375640037" class="block text-romark-gray-300 text-sm hover:text-romark-orange transition-colors">01375 640 037</a>
                </div>
              </div>

              <!-- Email -->
              <div class="flex gap-4">
                <div class="w-10 h-10 bg-romark-orange/20 rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-romark-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold mb-1">Email</h3>
                  <a href="mailto:jobs@romarkengineering.com" class="text-romark-gray-300 text-sm hover:text-romark-orange transition-colors">jobs@romarkengineering.com</a>
                </div>
              </div>

              <!-- Hours -->
              <div class="flex gap-4">
                <div class="w-10 h-10 bg-romark-orange/20 rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-romark-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold mb-1">Opening Hours</h3>
                  <p class="text-romark-gray-300 text-sm">Monday - Friday</p>
                  <p class="text-romark-gray-300 text-sm">7:00 AM - 5:00 PM</p>
                </div>
              </div>
            </div>

            <!-- Divider -->
            <div class="h-px bg-white/10 my-6"></div>

            <!-- Quick call CTA -->
            <a
              href="tel:01375673447"
              class="flex items-center justify-center gap-2 w-full px-6 py-3 border-2 border-romark-orange text-romark-orange font-semibold rounded hover:bg-romark-orange hover:text-white transition-colors"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              Call Us Now
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Placeholder -->
  <section class="bg-romark-light">
    <div class="max-w-7xl mx-auto px-4 py-(--spacing-section)">
      <div class="text-center mb-8">
        <div class="w-16 h-1 bg-romark-orange mx-auto mb-4"></div>
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-romark-blue-dark mb-2">
          Find Us
        </h2>
        <p class="text-romark-gray-500">Stanford-Le-Hope, Essex</p>
      </div>
      <div class="rounded-lg overflow-hidden border border-romark-gray-100 bg-romark-white aspect-[16/7]">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d9940.461890805878!2d0.4121!3d51.5143!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47d8b0d6b1f6e8f1%3A0x4a0b0e5b4c5e0e0!2sStanford-le-Hope!5e0!3m2!1sen!2suk!4v1"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Romark Engineering location — Stanford-Le-Hope, Essex"
          class="w-full h-full"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successEl = document.getElementById('form-success') as HTMLDivElement;
  const errorEl = document.getElementById('form-error') as HTMLDivElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    successEl.classList.add('hidden');
    errorEl.classList.add('hidden');

    // Basic client-side validation
    const name = (form.querySelector('#name') as HTMLInputElement).value.trim();
    const email = (form.querySelector('#email') as HTMLInputElement).value.trim();
    const message = (form.querySelector('#message') as HTMLTextAreaElement).value.trim();

    if (!name || !email || !message) {
      errorEl.textContent = 'Please fill in all required fields.';
      errorEl.classList.remove('hidden');
      return;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      errorEl.textContent = 'Please enter a valid email address.';
      errorEl.classList.remove('hidden');
      return;
    }

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.innerHTML = `
      <svg class="w-5 h-5 mr-2 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      Sending...
    `;

    try {
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        successEl.classList.remove('hidden');
        form.reset();
      } else {
        throw new Error('Server error');
      }
    } catch {
      errorEl.textContent = 'Something went wrong. Please try again or call us directly on 01375 673 447.';
      errorEl.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalText;
    }
  });
</script>
