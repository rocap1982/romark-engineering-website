---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CertBadges from '../components/CertBadges.astro';
---

<Layout
  title="About Us | Romark Engineering"
  description="Learn about Romark Engineering — precision engineering and sheet metal fabrication specialists in Stanford-Le-Hope, Essex. ISO 9001 and BS EN 1090 certified with decades of industry experience."
>
  <Hero
    title="About Romark Engineering"
    subtitle="Precision engineering and sheet metal fabrication specialists, delivering quality craftsmanship from our Essex facility for decades."
    ctaText="Get a Quote"
    ctaHref="/contact-us/"
    secondaryCtaText="Our Equipment"
    secondaryCtaHref="/equipment/"
  />

  <!-- Company Overview -->
  <section class="py-(--spacing-section) bg-romark-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="w-16 h-1 bg-romark-orange mb-4"></div>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-romark-blue-dark mb-6">
            Precision Engineering Excellence
          </h2>
          <p class="text-romark-gray-500 text-lg leading-relaxed mb-4">
            Romark Engineering is a precision engineering and sheet metal fabrication company based in Stanford-Le-Hope, Essex. We provide a comprehensive range of engineering services, from laser profiling and CNC machining to fabrication, welding, and CAD design.
          </p>
          <p class="text-romark-gray-500 text-lg leading-relaxed">
            Our clients span across the automotive, power generation, and architectural sectors, relying on our expertise to deliver components and assemblies to the highest standards of quality and precision.
          </p>
        </div>
        <div class="bg-romark-light rounded-lg p-8 border border-romark-gray-100">
          <div class="grid grid-cols-2 gap-6">
            <div class="text-center">
              <div class="text-3xl font-heading font-bold text-romark-orange mb-1">9</div>
              <div class="text-romark-gray-500 text-sm">Core Services</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-heading font-bold text-romark-orange mb-1">ISO</div>
              <div class="text-romark-gray-500 text-sm">9001 Certified</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-heading font-bold text-romark-orange mb-1">BS EN</div>
              <div class="text-romark-gray-500 text-sm">1090 Certified</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-heading font-bold text-romark-orange mb-1">100%</div>
              <div class="text-romark-gray-500 text-sm">In-House</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our History -->
  <section class="py-(--spacing-section) bg-romark-light">
    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <div class="w-16 h-1 bg-romark-orange mx-auto mb-4"></div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-romark-blue-dark mb-6">
          Our History
        </h2>
        <p class="text-romark-gray-500 text-lg leading-relaxed mb-4">
          With decades of experience in the precision engineering industry, Romark Engineering has built a reputation for reliability, quality, and technical expertise. From our early beginnings, we have grown into a fully equipped facility capable of handling projects from initial concept through to finished components.
        </p>
        <p class="text-romark-gray-500 text-lg leading-relaxed">
          Over the years, we have continually invested in the latest CNC machinery, laser cutting technology, and CAD software to ensure our customers receive the best possible service and the most precise results.
        </p>
      </div>
    </div>
  </section>

  <!-- Our Facility -->
  <section class="py-(--spacing-section) bg-romark-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-14">
        <div class="w-16 h-1 bg-romark-orange mx-auto mb-4"></div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-romark-blue-dark mb-4">
          Our Facility
        </h2>
        <p class="text-romark-gray-500 max-w-2xl mx-auto text-lg">
          Everything under one roof — from design to delivery.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            title: 'Laser Cutting',
            description: 'Amada 4Kw CO2 laser for precision profiling of steel up to 20mm and stainless up to 16mm.',
          },
          {
            title: 'CNC Machining',
            description: 'Haas VF-2 machining centre and Harrison Alpha CNC lathe for complex precision components.',
          },
          {
            title: 'Press Brakes',
            description: 'Amada CNC press brakes from 100 to 220 ton capacity with up to 3m folding lengths.',
          },
          {
            title: 'Welding Bay',
            description: 'Full TIG and MIG welding capabilities for steel, stainless steel, and aluminium.',
          },
          {
            title: 'Milling & Turning',
            description: 'Bridgeport mills and Colchester lathes with digital readout for manual precision work.',
          },
          {
            title: 'CAD Suite',
            description: 'Solidworks, AutoCAD, and Rhino3D for full 2D and 3D design and development.',
          },
        ].map((item) => (
          <div class="p-6 bg-romark-light rounded-lg border border-romark-gray-100">
            <div class="w-12 h-12 bg-romark-blue/10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-romark-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
              </svg>
            </div>
            <h3 class="font-heading font-bold text-lg text-romark-blue-dark mb-2">{item.title}</h3>
            <p class="text-romark-gray-500 text-sm leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-8">
        <a
          href="/equipment/"
          class="inline-flex items-center text-romark-orange font-semibold hover:text-romark-orange-dark transition-colors"
        >
          View our full equipment list
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="py-(--spacing-section) bg-romark-blue-dark text-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-14">
        <div class="w-16 h-1 bg-romark-orange mx-auto mb-4"></div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-4">
          Our Certifications
        </h2>
        <p class="text-romark-gray-300 max-w-2xl mx-auto text-lg">
          Quality and compliance are at the heart of everything we do.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div class="bg-white/5 rounded-lg p-8 border border-white/10">
          <h3 class="font-heading font-bold text-xl mb-3">ISO 9001</h3>
          <p class="text-romark-gray-300 leading-relaxed">
            Our ISO 9001 certification demonstrates our commitment to a robust quality management system. Every process, from initial enquiry to final delivery, is controlled and documented to ensure consistent, reliable results.
          </p>
        </div>
        <div class="bg-white/5 rounded-lg p-8 border border-white/10">
          <h3 class="font-heading font-bold text-xl mb-3">BS EN 1090</h3>
          <p class="text-romark-gray-300 leading-relaxed">
            Our BS EN 1090 certification confirms that our structural steel and aluminium fabrication meets European standards for structural components. This certification is essential for safety-critical applications in construction and architecture.
          </p>
        </div>
      </div>

      <div class="flex justify-center mt-10">
        <CertBadges size="lg" />
      </div>
    </div>
  </section>

  <!-- Our Commitment -->
  <section class="py-(--spacing-section) bg-romark-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-14">
        <div class="w-16 h-1 bg-romark-orange mx-auto mb-4"></div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-romark-blue-dark mb-4">
          Our Commitment
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-14 h-14 bg-romark-orange/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-romark-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="font-heading font-bold text-lg text-romark-blue-dark mb-2">Quality</h3>
          <p class="text-romark-gray-500 text-sm leading-relaxed">
            Every component is manufactured to exacting standards. Our ISO 9001 quality management system ensures consistency from first piece to last.
          </p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 bg-romark-orange/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-romark-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="font-heading font-bold text-lg text-romark-blue-dark mb-2">Precision</h3>
          <p class="text-romark-gray-500 text-sm leading-relaxed">
            With tolerances as tight as +/- 0.1mm, our advanced CNC equipment and skilled engineers deliver the accuracy your projects demand.
          </p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 bg-romark-orange/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-romark-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h3 class="font-heading font-bold text-lg text-romark-blue-dark mb-2">Customer Service</h3>
          <p class="text-romark-gray-500 text-sm leading-relaxed">
            We work closely with every client, from initial enquiry through to delivery. Our team is always available to discuss your requirements and provide expert guidance.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-(--spacing-section) bg-romark-light">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <div class="w-16 h-1 bg-romark-orange mx-auto mb-4"></div>
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-romark-blue-dark mb-4">
        Work With Us
      </h2>
      <p class="text-romark-gray-500 text-lg mb-8 max-w-2xl mx-auto">
        Whether you need a single prototype or a full production run, get in touch to discuss your requirements.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a
          href="/contact-us/"
          class="inline-flex items-center justify-center px-8 py-3.5 bg-romark-orange text-white font-semibold rounded hover:bg-romark-orange-dark transition-colors text-lg"
        >
          Contact Us
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
        <a
          href="tel:01375673447"
          class="inline-flex items-center justify-center px-8 py-3.5 border-2 border-romark-blue text-romark-blue font-semibold rounded hover:bg-romark-blue hover:text-white transition-colors text-lg"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          Call 01375 673 447
        </a>
      </div>
    </div>
  </section>
</Layout>
