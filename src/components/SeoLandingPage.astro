---
import { withBase } from '../lib/base';
import Hero from './Hero.astro';
import FAQ from './FAQ.astro';
import services from '../data/services.json';

interface Props {
  h1: string;
  content: string;
  location: string;
  relatedServices: string[];
  faqs: { question: string; answer: string }[];
}

const { h1, content, location, relatedServices, faqs } = Astro.props;

// Sanitise HTML content — only allow safe tags and attributes
const ALLOWED_TAGS = new Set(['h2', 'h3', 'h4', 'p', 'ul', 'ol', 'li', 'strong', 'em', 'a', 'br', 'span']);
const ALLOWED_ATTRS: Record<string, Set<string>> = {
  a: new Set(['href']),
};

function sanitiseHtml(html: string): string {
  // Strip <script>, <iframe>, <object>, <embed>, <form>, event handlers
  let clean = html
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<iframe[\s\S]*?<\/iframe>/gi, '')
    .replace(/<object[\s\S]*?<\/object>/gi, '')
    .replace(/<embed[\s\S]*?\/?>/gi, '')
    .replace(/<form[\s\S]*?<\/form>/gi, '')
    .replace(/<style[\s\S]*?<\/style>/gi, '');

  // Strip event handlers (on*="...") and javascript: hrefs
  clean = clean.replace(/\s+on\w+\s*=\s*["'][^"']*["']/gi, '');
  clean = clean.replace(/href\s*=\s*["']\s*javascript:[^"']*["']/gi, 'href="#"');

  // Strip disallowed tags but keep content
  clean = clean.replace(/<\/?([a-z][a-z0-9]*)\b[^>]*\/?>/gi, (match, tag: string) => {
    const lower = tag.toLowerCase();
    if (ALLOWED_TAGS.has(lower)) {
      // For allowed tags, strip disallowed attributes
      if (match.startsWith('</')) return match; // closing tag, keep as-is
      const allowedSet = ALLOWED_ATTRS[lower];
      if (!allowedSet) {
        // No attributes allowed — strip all
        return match.replace(/\s+[a-z-]+\s*=\s*["'][^"']*["']/gi, '');
      }
      // Keep only allowed attributes
      return match.replace(/\s+([a-z-]+)\s*=\s*["'][^"']*["']/gi, (attrMatch, attrName: string) => {
        return allowedSet.has(attrName.toLowerCase()) ? attrMatch : '';
      });
    }
    return ''; // strip the tag entirely
  });

  return clean;
}

const safeContent = sanitiseHtml(content);

const matchedServices = relatedServices
  .map((slug) => services.find((s) => s.slug === slug))
  .filter((s): s is (typeof services)[number] => s !== undefined);
---

<!-- Hero -->
<Hero
  title={h1}
  subtitle={location ? `Professional engineering services in ${location}` : 'Professional engineering services from Stanford-Le-Hope, Essex'}
  ctaText="Get a Quote"
  ctaHref="/contact-us/"
  secondaryCtaText="Our Services"
  secondaryCtaHref="/#services"
/>

<!-- Main Content -->
<section class="py-(--spacing-section) bg-romark-white">
  <div class="max-w-7xl mx-auto px-4">
    <div class="max-w-3xl mx-auto seo-content" set:html={safeContent} />
  </div>
</section>

<!-- Related Services -->
{matchedServices.length > 0 && (
  <section class="py-(--spacing-section) bg-romark-light">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-14">
        <div class="w-16 h-1 bg-romark-orange mx-auto mb-4"></div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-romark-blue-dark mb-4">
          Related Services
        </h2>
        <p class="text-romark-gray-500 max-w-2xl mx-auto text-lg">
          Explore the engineering services relevant to your project{location ? ` in ${location}` : ''}.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {matchedServices.map((service) => (
          <a
            href={withBase(`/${service.slug}/`)}
            class="group block p-6 bg-romark-white rounded-lg border border-romark-gray-100 hover:border-romark-orange/30 hover:shadow-lg transition-all duration-300"
          >
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 bg-romark-orange/10 rounded-lg flex items-center justify-center group-hover:bg-romark-orange/20 transition-colors">
                <svg class="w-5 h-5 text-romark-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-heading font-bold text-romark-blue-dark text-lg group-hover:text-romark-orange transition-colors">
                  {service.name}
                </h3>
                <p class="text-romark-gray-500 text-sm mt-1 leading-relaxed">
                  {service.shortDescription}
                </p>
              </div>
            </div>
            <div class="mt-4 flex items-center text-romark-orange text-sm font-semibold">
              Learn more
              <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<!-- FAQ Section -->
{faqs.length > 0 && (
  <section class="py-(--spacing-section) bg-romark-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-14">
        <div class="w-16 h-1 bg-romark-orange mx-auto mb-4"></div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-romark-blue-dark mb-4">
          Frequently Asked Questions
        </h2>
      </div>
      <div class="max-w-3xl mx-auto">
        <FAQ faqs={faqs} />
      </div>
    </div>
  </section>
)}

<!-- CTA Section -->
<section class="py-(--spacing-section) bg-romark-blue-dark text-white">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <div class="w-16 h-1 bg-romark-orange mx-auto mb-4"></div>
    <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-4">
      Ready to Discuss Your Project?
    </h2>
    <p class="text-romark-gray-300 text-lg mb-8 max-w-2xl mx-auto">
      Contact our team{location ? ` in ${location}` : ''} for a free, no-obligation quote. Whether you need a single prototype or a full production run, we're here to help.
    </p>
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a
        href={withBase("/contact-us/")}
        class="inline-flex items-center justify-center px-8 py-3.5 bg-romark-orange text-white font-semibold rounded hover:bg-romark-orange-dark transition-colors text-lg"
      >
        Get a Quote
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
      <a
        href="tel:01375673447"
        class="inline-flex items-center justify-center px-8 py-3.5 border-2 border-white/30 text-white font-semibold rounded hover:border-romark-orange hover:text-romark-orange transition-colors text-lg"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
        Call 01375 673 447
      </a>
    </div>
  </div>
</section>

<style is:global>
  .seo-content h2 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.875rem;
    line-height: 2.25rem;
    color: var(--color-romark-blue-dark);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .seo-content h3 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 2rem;
    color: var(--color-romark-blue-dark);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .seo-content p {
    color: var(--color-romark-gray-500);
    font-size: 1.125rem;
    line-height: 1.875rem;
    margin-bottom: 1.25rem;
  }

  .seo-content ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .seo-content ul li {
    color: var(--color-romark-gray-500);
    font-size: 1.125rem;
    line-height: 1.875rem;
    margin-bottom: 0.5rem;
  }

  .seo-content a {
    color: var(--color-romark-orange);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .seo-content a:hover {
    color: var(--color-romark-orange-dark);
  }

  .seo-content strong {
    color: var(--color-romark-blue-dark);
    font-weight: 600;
  }
</style>
