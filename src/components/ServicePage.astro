---
import Hero from './Hero.astro';

interface Props {
  name: string;
  description: string;
  capabilities: string[];
  materials: string[];
  equipment: string[];
  image: string;
  shortDescription?: string;
}

const {
  name,
  description,
  capabilities,
  materials,
  equipment,
  image,
  shortDescription,
} = Astro.props;
---

<!-- Hero -->
<Hero
  title={name}
  subtitle={shortDescription}
  ctaText="Get a Quote"
  ctaHref="/contact-us/"
  secondaryCtaText="All Services"
  secondaryCtaHref="/#services"
/>

<!-- Description -->
<section class="py-(--spacing-section) bg-romark-white">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="w-16 h-1 bg-romark-orange mb-6"></div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-romark-blue-dark mb-6">
          About Our {name} Service
        </h2>
        <p class="text-romark-gray-500 text-lg leading-relaxed">
          {description}
        </p>
      </div>
      <div class="relative">
        <div class="aspect-[4/3] rounded-lg overflow-hidden bg-romark-gray-100">
          <img
            src={image}
            alt={`${name} service at Romark Engineering`}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <!-- Decorative accent -->
        <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-romark-orange/10 rounded-lg -z-10"></div>
      </div>
    </div>
  </div>
</section>

<!-- Capabilities -->
{capabilities.length > 0 && (
  <section class="py-(--spacing-section) bg-romark-light">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-14">
        <div class="w-16 h-1 bg-romark-orange mx-auto mb-4"></div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-romark-blue-dark mb-4">
          Capabilities
        </h2>
        <p class="text-romark-gray-500 max-w-2xl mx-auto text-lg">
          What we deliver with our {name.toLowerCase()} service.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl mx-auto">
        {capabilities.map((capability) => (
          <div class="flex items-start gap-3 p-4 bg-romark-white rounded-lg border border-romark-gray-100">
            <div class="flex-shrink-0 w-6 h-6 bg-romark-orange/10 rounded-full flex items-center justify-center mt-0.5">
              <svg class="w-4 h-4 text-romark-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-romark-gray-700 font-body">{capability}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Equipment -->
{equipment.length > 0 && (
  <section class="py-(--spacing-section) bg-romark-blue-dark text-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-14">
        <div class="w-16 h-1 bg-romark-orange mx-auto mb-4"></div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-4">
          Equipment
        </h2>
        <p class="text-romark-gray-300 max-w-2xl mx-auto text-lg">
          The machines and tools powering our {name.toLowerCase()} service.
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-6">
        {equipment.map((item) => (
          <div class="flex items-center gap-3 px-6 py-4 bg-white/10 rounded-lg border border-white/10">
            <svg class="w-6 h-6 text-romark-orange flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="font-heading font-semibold text-white">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Materials -->
{materials.length > 0 && (
  <section class="py-(--spacing-section) bg-romark-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-14">
        <div class="w-16 h-1 bg-romark-orange mx-auto mb-4"></div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-romark-blue-dark mb-4">
          Materials We Work With
        </h2>
      </div>

      <div class="flex flex-wrap justify-center gap-3">
        {materials.map((material) => (
          <span class="inline-flex items-center px-5 py-2.5 bg-romark-blue/5 border border-romark-blue/15 rounded-full text-romark-blue-dark font-heading font-semibold text-sm capitalize">
            {material}
          </span>
        ))}
      </div>
    </div>
  </section>
)}

<!-- CTA -->
<section class="py-(--spacing-section) bg-romark-light">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <div class="w-16 h-1 bg-romark-orange mx-auto mb-4"></div>
    <h2 class="text-3xl md:text-4xl font-heading font-bold text-romark-blue-dark mb-4">
      Ready to Start Your Project?
    </h2>
    <p class="text-romark-gray-500 text-lg mb-8 max-w-2xl mx-auto">
      Whether you need a single prototype or a full production run, our team is ready to help. Get in touch for a free, no-obligation quote.
    </p>
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a
        href="/contact-us/"
        class="inline-flex items-center justify-center px-8 py-3.5 bg-romark-orange text-white font-semibold rounded hover:bg-romark-orange-dark transition-colors text-lg"
      >
        Request a Quote
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
      <a
        href="tel:01375673447"
        class="inline-flex items-center justify-center px-8 py-3.5 border-2 border-romark-blue text-romark-blue font-semibold rounded hover:bg-romark-blue hover:text-white transition-colors text-lg"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
        Call 01375 673 447
      </a>
    </div>
  </div>
</section>
