---
import { withBase, stripBase } from '../lib/base';
const services = [
  { name: 'Laser Profiling', href: '/laser-profiling/' },
  { name: 'Folding & Pressing', href: '/folding-pressing/' },
  { name: 'Fabrication & Welding', href: '/fabrication-and-welding/' },
  { name: 'CNC Machining', href: '/cnc-machining/' },
  { name: 'Milling', href: '/milling/' },
  { name: 'Turning', href: '/turning/' },
  { name: 'Sheet Metal Welding', href: '/sheet-metal-welding/' },
  { name: 'Blank Development', href: '/blank-development/' },
  { name: 'CAD Design', href: '/cad/' },
];

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Equipment', href: '/equipment/' },
  { name: 'Gallery', href: '/gallery/' },
  { name: 'About Us', href: '/about-us/' },
  { name: 'Contact', href: '/contact-us/' },
];

const currentPath = stripBase(Astro.url.pathname);
---

<!-- Top Bar -->
<div class="bg-romark-blue-dark text-white text-sm">
  <div class="max-w-7xl mx-auto px-4 py-2 flex justify-between items-center">
    <div class="flex items-center gap-4">
      <a href="tel:01375673447" class="flex items-center gap-1 text-white hover:text-romark-orange transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
        01375 673 447
      </a>
      <span class="hidden sm:inline text-romark-gray-300">|</span>
      <a href="mailto:jobs@romarkengineering.com" class="hidden sm:flex items-center gap-1 text-white hover:text-romark-orange transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        jobs@romarkengineering.com
      </a>
    </div>
    <div class="hidden md:flex items-center gap-2 text-romark-gray-300 text-xs">
      <span>ISO 9001</span>
      <span>|</span>
      <span>BS EN 1090</span>
    </div>
  </div>
</div>

<!-- Main Navigation -->
<header class="bg-romark-white sticky top-0 z-40 shadow-md">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between h-[90px]">
      <!-- Logo -->
      <a href={withBase("/")} class="flex items-center shrink-0 -ml-2">
        <img src={withBase("/images/logo-gear.png")} alt="" class="h-16 w-auto relative left-[1px] top-[10px]" />
        <span class="font-brand text-romark-blue-dark text-[1.35rem] tracking-[0.15em] leading-[1.1] -ml-3 relative left-[-10px] top-[-15px]">ROMARK<br/>ENGINEERING</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        <a
          href={withBase("/")}
          class:list={[
            'px-3 py-2 text-sm font-medium rounded transition-colors',
            currentPath === '/' ? 'text-romark-orange' : 'text-romark-gray-700 hover:text-romark-orange',
          ]}
        >
          Home
        </a>

        <!-- Services Dropdown -->
        <div class="relative group">
          <button
            class:list={[
              'px-3 py-2 text-sm font-medium rounded transition-colors flex items-center gap-1',
              currentPath.includes('/laser-profiling') || currentPath.includes('/fabrication') || currentPath.includes('/cnc') || currentPath.includes('/milling') || currentPath.includes('/turning') || currentPath.includes('/sheet-metal') || currentPath.includes('/blank') || currentPath.includes('/cad') || currentPath.includes('/folding')
                ? 'text-romark-orange'
                : 'text-romark-gray-700 hover:text-romark-orange',
            ]}
            aria-expanded="false"
            aria-haspopup="true"
          >
            Services
            <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div class="absolute top-full left-0 mt-0 w-64 bg-white shadow-xl rounded-b-lg border border-romark-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            {services.map((service) => (
              <a
                href={withBase(service.href)}
                class:list={[
                  'block px-4 py-2.5 text-sm transition-colors border-b border-romark-gray-100 last:border-0',
                  currentPath === service.href
                    ? 'text-romark-orange bg-romark-light'
                    : 'text-romark-gray-700 hover:text-romark-orange hover:bg-romark-light',
                ]}
              >
                {service.name}
              </a>
            ))}
          </div>
        </div>

        {navLinks.slice(1).map((link) => (
          <a
            href={withBase(link.href)}
            class:list={[
              'px-3 py-2 text-sm font-medium rounded transition-colors',
              currentPath === link.href ? 'text-romark-orange' : 'text-romark-gray-700 hover:text-romark-orange',
            ]}
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- CTA + Mobile Toggle -->
      <div class="flex items-center gap-3">
        <a
          href={withBase("/contact-us/")}
          class="hidden md:inline-flex items-center px-5 py-2.5 bg-romark-orange text-white text-sm font-semibold rounded hover:bg-romark-orange-dark transition-colors"
        >
          Get a Quote
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden p-2 text-romark-gray-700 hover:text-romark-orange"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-romark-gray-100">
    <div class="max-w-7xl mx-auto px-4 py-4 space-y-1">
      <a href={withBase("/")} class="block px-3 py-2 text-sm font-medium rounded text-romark-gray-700 hover:text-romark-orange hover:bg-romark-light">Home</a>

      <div>
        <button id="mobile-services-toggle" class="w-full flex items-center justify-between px-3 py-2 text-sm font-medium text-romark-gray-700 hover:text-romark-orange">
          Services
          <svg id="mobile-services-chevron" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <div id="mobile-services-list" class="hidden pl-4 space-y-1">
          {services.map((service) => (
            <a href={withBase(service.href)} class="block px-3 py-2 text-sm text-romark-gray-500 hover:text-romark-orange">
              {service.name}
            </a>
          ))}
        </div>
      </div>

      {navLinks.slice(1).map((link) => (
        <a href={withBase(link.href)} class="block px-3 py-2 text-sm font-medium rounded text-romark-gray-700 hover:text-romark-orange hover:bg-romark-light">
          {link.name}
        </a>
      ))}

      <a href={withBase("/contact-us/")} class="block text-center mt-3 px-5 py-2.5 bg-romark-orange text-white text-sm font-semibold rounded hover:bg-romark-orange-dark transition-colors">
        Get a Quote
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const servicesToggle = document.getElementById('mobile-services-toggle');
  const servicesList = document.getElementById('mobile-services-list');
  const servicesChevron = document.getElementById('mobile-services-chevron');

  menuBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    menuBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  servicesToggle?.addEventListener('click', () => {
    servicesList?.classList.toggle('hidden');
    servicesChevron?.classList.toggle('rotate-180');
  });
</script>
