---
interface Props {
  faqs: { question: string; answer: string }[];
}

const { faqs } = Astro.props;
---

<div class="divide-y divide-romark-gray-100">
  {faqs.map((faq, i) => (
    <div class="faq-item">
      <button
        id={`faq-btn-${i}`}
        class="faq-toggle w-full flex items-center justify-between gap-4 py-5 px-1 text-left font-heading text-lg font-semibold text-romark-blue-dark hover:text-romark-orange transition-colors cursor-pointer"
        aria-expanded="false"
        aria-controls={`faq-panel-${i}`}
      >
        <span>{faq.question}</span>
        <svg
          class="faq-chevron w-5 h-5 shrink-0 text-romark-orange transition-transform duration-300"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div
        id={`faq-panel-${i}`}
        role="region"
        aria-labelledby={`faq-btn-${i}`}
        class="faq-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out"
      >
        <div class="overflow-hidden">
          <p class="px-1 pb-5 text-romark-gray-500 leading-relaxed">{faq.answer}</p>
        </div>
      </div>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const panelId = btn.getAttribute('aria-controls');
      const panel = document.getElementById(panelId!);
      const chevron = btn.querySelector('.faq-chevron');

      btn.setAttribute('aria-expanded', String(!expanded));
      panel?.classList.toggle('grid-rows-[0fr]', expanded);
      panel?.classList.toggle('grid-rows-[1fr]', !expanded);
      chevron?.classList.toggle('rotate-180', !expanded);
    });
  });
</script>
