---
import { withBase } from '../lib/base';
import CertBadges from './CertBadges.astro';

const services = [
  { name: 'Laser Profiling', href: '/laser-profiling/' },
  { name: 'Folding & Pressing', href: '/folding-pressing/' },
  { name: 'Fabrication & Welding', href: '/fabrication-and-welding/' },
  { name: 'CNC Machining', href: '/cnc-machining/' },
  { name: 'Milling', href: '/milling/' },
  { name: 'Turning', href: '/turning/' },
  { name: 'Sheet Metal Welding', href: '/sheet-metal-welding/' },
  { name: 'Blank Development', href: '/blank-development/' },
  { name: 'CAD Design', href: '/cad/' },
];

const quickLinks = [
  { name: 'Home', href: '/' },
  { name: 'Equipment', href: '/equipment/' },
  { name: 'Gallery', href: '/gallery/' },
  { name: 'About Us', href: '/about-us/' },
  { name: 'Contact Us', href: '/contact-us/' },
];

const areas = [
  { name: 'Precision Engineering Essex', href: '/precision-engineering-essex/' },
  { name: 'Sheet Metal Fabrication Essex', href: '/sheet-metal-fabrication-essex/' },
  { name: 'Laser Cutting Essex', href: '/laser-cutting-essex/' },
  { name: 'Precision Engineering London', href: '/precision-engineering-london/' },
  { name: 'Precision Engineering Basildon', href: '/precision-engineering-basildon/' },
  { name: 'CNC Machining Kent', href: '/cnc-machining-kent/' },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-romark-blue-dark text-white">
  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-4 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">

      <!-- Company Info -->
      <div>
        <div class="mb-5">
          <div class="flex items-center -ml-2">
            <img src={withBase("/images/logo-gear.png")} alt="" class="h-12 w-auto brightness-0 invert" />
            <span class="font-brand text-white text-base tracking-[0.15em] leading-[1.1] -ml-2">ROMARK<br/>ENGINEERING</span>
          </div>
        </div>
        <p class="text-romark-gray-300 text-sm mb-5 leading-relaxed">
          Precision engineering and sheet metal fabrication specialists serving automotive, power generation, and architectural industries from our Essex facility.
        </p>
        <CertBadges size="sm" />
      </div>

      <!-- Services -->
      <div>
        <h3 class="font-heading font-bold text-lg mb-4 text-white">Our Services</h3>
        <ul class="space-y-2">
          {services.map((service) => (
            <li>
              <a href={withBase(service.href)} class="text-romark-gray-300 text-sm hover:text-romark-orange transition-colors">
                {service.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-heading font-bold text-lg mb-4 text-white">Quick Links</h3>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a href={withBase(link.href)} class="text-romark-gray-300 text-sm hover:text-romark-orange transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Areas We Serve -->
      <div>
        <h3 class="font-heading font-bold text-lg mb-4 text-white">Areas We Serve</h3>
        <ul class="space-y-2">
          {areas.map((area) => (
            <li>
              <a href={withBase(area.href)} class="text-romark-gray-300 text-sm hover:text-romark-orange transition-colors">
                {area.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="font-heading font-bold text-lg mb-4 text-white">Contact Us</h3>
        <div class="space-y-3 text-sm">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-romark-orange shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span class="text-romark-gray-300">Stanford-Le-Hope,<br />Essex, UK</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-romark-orange shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <div class="text-romark-gray-300">
              <a href="tel:01375673447" class="hover:text-romark-orange transition-colors block">01375 673 447</a>
              <a href="tel:01375640037" class="hover:text-romark-orange transition-colors block">01375 640 037</a>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-romark-orange shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href="mailto:jobs@romarkengineering.com" class="text-romark-gray-300 hover:text-romark-orange transition-colors">
              jobs@romarkengineering.com
            </a>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-romark-orange shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="text-romark-gray-300">Mon-Fri: 7:00 - 17:00</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-romark-blue-light">
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-romark-gray-300">
      <p>&copy; {currentYear} Romark Engineering. All rights reserved.</p>
      <p>Precision Engineering &amp; Sheet Metal Fabrication — Stanford-Le-Hope, Essex</p>
    </div>
  </div>
</footer>
